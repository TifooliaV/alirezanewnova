{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alirezanewnova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7e1a609a-c533-4b4b-aa21-1f78c13e9d59","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "00da63b310c0489ba6ad5beaef8b2c1f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
